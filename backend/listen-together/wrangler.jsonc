{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xan-listen-together",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "ListenTogetherRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ListenTogetherRoom"] }
  ]
}
